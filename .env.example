# Пример конфигурации Book Expert.
# Скопируйте файл в .env и измените значения при необходимости:
#   cp .env.example .env
# .env игнорируется git-ом — не коммитьте секреты и реальные ключи.
# Все переменные читаются pydantic-settings с префиксом BOOK_EXPERT_.

# --- Workspace и данные (только локально, git-ignored) ---
# Корень workspace; пустое значение — текущий каталог.
BOOK_EXPERT_WORKSPACE=
# Каталог данных относительно workspace: raw/, processed/, artifacts/, audit/.
BOOK_EXPERT_DATA_DIR=data

# --- Qdrant (Docker Compose, доступен только на loopback) ---
BOOK_EXPERT_QDRANT_URL=http://127.0.0.1:6333
# Ключ нужен только для внешнего Qdrant; локальный контейнер работает без auth.
BOOK_EXPERT_QDRANT_API_KEY=
BOOK_EXPERT_QDRANT_COLLECTION=books

# --- Провайдер моделей: ollama (локально), openai или deepseek (opt-in) ---
BOOK_EXPERT_PROVIDER=ollama

# --- Ollama ---
BOOK_EXPERT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Контекст Ollama: prompt + ответ. Малый num_ctx обрывает длинные ответы super.
BOOK_EXPERT_OLLAMA_NUM_CTX=8192
# true — разрешить thinking (content может оказаться пустым при малом лимите токенов).
BOOK_EXPERT_OLLAMA_THINK=false
BOOK_EXPERT_CHAT_MODEL=qwen3.5:4b
BOOK_EXPERT_EMBEDDING_MODEL=bge-m3
# Размерность должна совпадать с моделью эмбеддингов (bge-m3 = 1024).
BOOK_EXPERT_EMBEDDING_DIM=1024

# --- OpenAI-совместимый провайдер (используется только при PROVIDER=openai) ---
BOOK_EXPERT_OPENAI_API_KEY=
BOOK_EXPERT_OPENAI_BASE_URL=
BOOK_EXPERT_OPENAI_CHAT_MODEL=gpt-4o-mini
BOOK_EXPERT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- DeepSeek: chat в облако, embeddings остаются локальными в Ollama ---
BOOK_EXPERT_DEEPSEEK_API_KEY=
BOOK_EXPERT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
BOOK_EXPERT_DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- Chunking и retrieval ---
BOOK_EXPERT_CHUNK_SIZE=1000
BOOK_EXPERT_CHUNK_OVERLAP=150
# Удалять повторяющиеся колонтитулы и номера страниц из текста перед chunking.
# На реальной книге выигрыша в recall/MRR не дало — по умолчанию выключено.
BOOK_EXPERT_STRIP_RUNNING_HEADERS=false
BOOK_EXPERT_TOP_K=8
# Порог уверенности router-а при авто-выборе книг, диапазон [0, 1].
BOOK_EXPERT_ROUTER_CONFIDENCE_THRESHOLD=0.6
# Доля IDF-score лучшего источника, ниже которой источник отбрасывается
# relevance-фильтром ask_books (диапазон [0, 1]; 0 — не фильтровать).
BOOK_EXPERT_RELEVANCE_FILTER_MIN_RATIO=0.5
# Веса RRF: dense-поиск и лексика. 0 для лексики — только dense.
BOOK_EXPERT_RRF_DENSE_WEIGHT=1.0
BOOK_EXPERT_RRF_LEXICAL_WEIGHT=0.1
# and — все токены должны встретиться; or_prefix5 — OR по 5-символьным префиксам.
BOOK_EXPERT_LEXICAL_QUERY_MODE=and
# Использовать lemma-индекс FTS5 (pymorphy3); нужен reindex-lemmas.
BOOK_EXPERT_LEXICAL_USE_LEMMAS=true
# Сколько фрагментов брать на каждый поисковый запрос в advanced/super.
BOOK_EXPERT_ADVANCED_QUERY_LIMIT=4
# Сколько раз super-режим может вернуться к плану за доп. запросами.
BOOK_EXPERT_SUPER_MAX_ROUNDS=5

# --- Reranker (cross-encoder поверх гибридного поиска) ---
# true — переранжировать top-N кандидатов моделью fastembed (ONNX, без torch).
# Модель скачивается один раз (~1.1 GB) при первом поиске; см. `doctor`.
BOOK_EXPERT_RERANK_ENABLED=false
BOOK_EXPERT_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Сколько fused-кандидатов отдавать reranker-у; итоговый top-k задаёт TOP_K.
BOOK_EXPERT_RERANK_TOP_N=20

# --- Веб-чат и библиотека ---
# Максимальный размер PDF, загружаемого через UI, в мегабайтах.
BOOK_EXPERT_MAX_UPLOAD_MB=200
# Пакетный импорт из папки: сколько PDF за один запуск и их суммарный объём.
BOOK_EXPERT_IMPORT_MAX_FILES=500
BOOK_EXPERT_IMPORT_MAX_FILE_MB=500
BOOK_EXPERT_IMPORT_MAX_TOTAL_MB=50000

# --- Агентный режим ---
BOOK_EXPERT_AGENT_MAX_STEPS=12
BOOK_EXPERT_AGENT_TIMEOUT_S=120
BOOK_EXPERT_COMMAND_TIMEOUT_S=30
BOOK_EXPERT_MAX_OUTPUT_BYTES=100000
# false — только read-only инструменты (rag/read/list), без shell/write/git.
BOOK_EXPERT_AUTONOMY=true
# Разрешить сеть в bwrap и remote git (push/fetch/pull/clone); по умолчанию запрещено.
BOOK_EXPERT_ALLOW_REMOTE=false
# Писать текст найденных фрагментов в трейсы; по умолчанию только метаданные.
BOOK_EXPERT_TRACE_TEXT=false
BOOK_EXPERT_LOG_LEVEL=INFO
