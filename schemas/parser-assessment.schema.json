{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page-level parser assessment record",
  "description": "Schema for a single page-level PDF parser assessment record. Synthetic-only scaffold: must never carry real book data, extracted text, OCR text, citations, real page numbers, or file-system paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser",
    "document_ref",
    "page_ref",
    "page_types",
    "criteria",
    "review",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "configuration_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configuration_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Anonymized document reference. Must not contain extracted content, OCR text, or file-system paths."
    },
    "page_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_page_index",
        "printed_page_label"
      ],
      "properties": {
        "pdf_page_index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based page index inside the PDF file."
        },
        "printed_page_label": {
          "type": "string",
          "minLength": 1,
          "description": "Label printed on the physical page. Synthetic placeholder only in tracked fixtures."
        }
      }
    },
    "page_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "body_text",
          "mixed_language",
          "table_of_contents",
          "table",
          "footnote",
          "header_footer",
          "image_or_diagram",
          "callout",
          "heading_hierarchy",
          "end_boundary"
        ]
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_coverage",
        "reading_order",
        "heading_structure",
        "table_fidelity",
        "footnote_separation",
        "header_footer_handling",
        "image_handling",
        "page_linkage",
        "runtime"
      ],
      "properties": {
        "text_coverage": {
          "$ref": "#/$defs/status"
        },
        "reading_order": {
          "$ref": "#/$defs/status"
        },
        "heading_structure": {
          "$ref": "#/$defs/status"
        },
        "table_fidelity": {
          "$ref": "#/$defs/status"
        },
        "footnote_separation": {
          "$ref": "#/$defs/status"
        },
        "header_footer_handling": {
          "$ref": "#/$defs/status"
        },
        "image_handling": {
          "$ref": "#/$defs/status"
        },
        "page_linkage": {
          "$ref": "#/$defs/status"
        },
        "runtime": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms"
      ],
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Parser wall-clock time for this page, in milliseconds."
        }
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail",
        "not_applicable"
      ]
    }
  }
}
